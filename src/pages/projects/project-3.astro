---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
---

<Layout title="PVP Shooter Level — Christopher St George">
  <article class="project-page">
    <a href="/" class="back-link">&larr; Back to all projects</a>

    <h1>PVP Shooter Level</h1>
    <p class="project-meta">
      Level Designer (Solo)
    </p>

    <div class="project-body">
      <div class="project-text">
        <section>
          <h2>Overview</h2>
          <p>
            A level for a PVP shooter, solo developed using an asset pack.
          </p>
        </section>

        <section>
          <h2>What I did</h2>
          <p>
            My main contribution was designing the level layout and environment
            design.
          </p>
        </section>

        <section>
          <h2>Tools &amp; technologies</h2>
          <ul class="tag-list">
            <li>EDIT THIS</li>
            <li>EDIT THIS</li>
            <li>EDIT THIS</li>
          </ul>
        </section>
      </div>

      <div class="project-gallery">
        <!--
          EDIT THIS: once you have real images, put them in public/images/
          and change each "src" below from the placeholder URL to
          something like "/images/project-3-layout.jpg". Add or remove
          objects from this list for more or fewer photos.
        -->
        <Gallery
          images={[
            { src: 'https://placehold.co/800x600/1b1e25/9299a6?text=Level+Layout', alt: 'Level layout, top-down' },
            { src: 'https://placehold.co/800x600/1b1e25/9299a6?text=In-Game+Screenshot', alt: 'In-game screenshot' },
            { src: 'https://placehold.co/800x600/1b1e25/9299a6?text=Lighting+Pass', alt: 'Lighting pass screenshot' },
          ]}
        />

        <!--
          EDIT THIS: paste your YouTube video's ID below — it's the part
          after "v=" in a normal youtube.com/watch?v=... URL. Then delete
          the placeholder <div> underneath and uncomment this iframe.

          <div class="project-video">
            <iframe
              src="https://www.youtube.com/embed/YOUTUBE_VIDEO_ID"
              title="Project video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        -->
        <div class="video-placeholder">YouTube video will go here</div>
      </div>
    </div>
  </article>
</Layout>
