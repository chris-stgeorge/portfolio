---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Project One — [Your Name]">
  <article class="project-page">
    <a href="/" class="back-link">&larr; Back to all projects</a>

    <h1>Project One</h1>
    <p class="project-meta">
      EDIT THIS: your role · timeframe — e.g. "Lead Developer · 2024"
    </p>

    <section>
      <h2>Overview</h2>
      <p>
        EDIT THIS: what is this project? What problem does it solve, and who
        is it for? Two or three sentences is plenty.
      </p>
    </section>

    <section>
      <h2>What I did</h2>
      <p>
        EDIT THIS: your specific contributions. What did you build, design,
        or decide? Feel free to turn this into a bulleted list if that reads
        better — just wrap items in &lt;ul&gt;&lt;li&gt;...&lt;/li&gt;&lt;/ul&gt;.
      </p>
    </section>

    <section>
      <h2>Tools &amp; technologies</h2>
      <ul class="tag-list">
        <li>EDIT THIS</li>
        <li>EDIT THIS</li>
        <li>EDIT THIS</li>
      </ul>
    </section>

    <section>
      <!-- If this project has a live link or repo, keep this. Otherwise delete the <p> below. -->
      <p>
        <a href="https://example.com" class="project-cta">View the live project &rarr;</a>
      </p>
    </section>
  </article>
</Layout>
