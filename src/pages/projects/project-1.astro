---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
---

<Layout title="Psychological Manipulation Simulator — Christopher St George">
  <article class="project-page">
    <a href="/" class="back-link">&larr; Back to all projects</a>

    <h1>Psychological Manipulation Simulator</h1>
    <p class="project-meta">
      Card Artist
    </p>

    <div class="project-body">
      <div class="project-text">
        <section>
          <h2>Overview</h2>
          <p>
            Psychological Manipulation Simulator is an idle game built around a
            collectible card system.
          </p>
        </section>

        <section>
          <h2>What I did</h2>
          <p>
            My main contribution was creating 52 pieces of collectible card
            artwork for the game.
          </p>
        </section>

        <section>
          <h2>Tools &amp; technologies</h2>
          <ul class="tag-list">
            <li>EDIT THIS</li>
            <li>EDIT THIS</li>
            <li>EDIT THIS</li>
          </ul>
        </section>
      </div>

      <div class="project-gallery">
        <!--
          EDIT THIS: once you have real images, put them in public/images/
          and change each "src" below from the placeholder URL to
          something like "/images/project-1-card-1.jpg". Add or remove
          objects from this list for more or fewer photos — the gallery
          adapts automatically.
        -->
        <Gallery
          images={[
            { src: 'https://placehold.co/800x600/1b1e25/9299a6?text=Card+Artwork+1', alt: 'Card artwork 1' },
            { src: 'https://placehold.co/800x600/1b1e25/9299a6?text=Card+Artwork+2', alt: 'Card artwork 2' },
            { src: 'https://placehold.co/800x600/1b1e25/9299a6?text=Card+Artwork+3', alt: 'Card artwork 3' },
          ]}
        />

        <!--
          EDIT THIS: paste your YouTube video's ID below — it's the part
          after "v=" in a normal youtube.com/watch?v=... URL. Then delete
          the placeholder <div> underneath and uncomment this iframe.

          <div class="project-video">
            <iframe
              src="https://www.youtube.com/embed/YOUTUBE_VIDEO_ID"
              title="Project video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        -->
        <div class="video-placeholder">YouTube video will go here</div>
      </div>
    </div>
  </article>
</Layout>
