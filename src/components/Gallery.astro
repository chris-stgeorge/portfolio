---
// A "component" is a reusable snippet — one file you can drop into
// multiple pages, feeding it different content each time via props
// (here, a list of images). Every project page uses this same file,
// so editing the gallery's behavior here updates it everywhere at once.
interface Image {
  src: string;
  alt: string;
}
interface Props {
  images: Image[];
}
const { images } = Astro.props;
---

<div class="gallery">
  <button type="button" class="gallery-main" aria-label="View image full-screen">
    <img src={images[0].src} alt={images[0].alt} />
  </button>
  <div class="gallery-thumbs">
    {images.map((image, i) => (
      <button
        type="button"
        class:list={['gallery-thumb', { active: i === 0 }]}
        data-src={image.src}
        data-alt={image.alt}
        aria-label={`Show image ${i + 1}`}
      >
        <img src={image.src} alt="" />
      </button>
    ))}
  </div>
</div>

<script>
  // Runs in the visitor's browser (not on the server, unlike the fenced
  // section above). For every gallery on the page: clicking a thumbnail
  // swaps the big image above it to match, and highlights that thumbnail.
  // Clicking the big image itself opens it full-screen.
  document.querySelectorAll('.gallery').forEach((gallery) => {
    const mainButton = gallery.querySelector('.gallery-main');
    const mainImage = mainButton.querySelector('img');
    const thumbs = gallery.querySelectorAll('.gallery-thumb');

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        mainImage.setAttribute('src', thumb.dataset.src);
        mainImage.setAttribute('alt', thumb.dataset.alt);
        thumbs.forEach((t) => t.classList.remove('active'));
        thumb.classList.add('active');
      });
    });

    mainButton.addEventListener('click', () => {
      openLightbox(mainImage.src, mainImage.alt);
    });
  });

  // One full-screen viewer, shared by every gallery on the page — created
  // the first time it's needed. Clicking it anywhere, pressing Escape, or
  // hitting the close button all close it again.
  function openLightbox(src, alt) {
    let lightbox = document.querySelector('.lightbox');
    if (!lightbox) {
      lightbox = document.createElement('div');
      lightbox.className = 'lightbox';
      lightbox.innerHTML =
        '<button type="button" class="lightbox-close" aria-label="Close full-screen image">&times;</button><img />';
      document.body.appendChild(lightbox);

      lightbox.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeLightbox();
      });
    }
    const lightboxImage = lightbox.querySelector('img');
    lightboxImage.src = src;
    lightboxImage.alt = alt;
    lightbox.classList.add('open');
  }

  function closeLightbox() {
    const lightbox = document.querySelector('.lightbox');
    if (lightbox) lightbox.classList.remove('open');
  }
</script>
