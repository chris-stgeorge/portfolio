---
// A "component" is a reusable snippet — one file you can drop into
// multiple pages, feeding it different content each time via props
// (here, a list of images). Every project page uses this same file,
// so editing the gallery's behavior here updates it everywhere at once.
interface Image {
  src: string;
  alt: string;
}
interface Props {
  images: Image[];
}
const { images } = Astro.props;
---

<div class="gallery">
  <button type="button" class="gallery-main" aria-label="View image full-screen">
    <img src={images[0].src} alt={images[0].alt} />
  </button>
  <div class="gallery-thumbs">
    {images.map((image, i) => (
      <button
        type="button"
        class:list={['gallery-thumb', { active: i === 0 }]}
        data-src={image.src}
        data-alt={image.alt}
        aria-label={`Show image ${i + 1}`}
      >
        <img src={image.src} alt="" />
      </button>
    ))}
  </div>
</div>

<script>
  // Runs in the visitor's browser (not on the server, unlike the fenced
  // section above). For every gallery on the page: clicking a thumbnail (or
  // navigating full-screen) swaps the big image to match and highlights the
  // right thumbnail. Clicking the big image opens it full-screen, where you
  // can still step through the same set of photos with the arrow buttons,
  // the ← → keys, or by clicking a thumbnail behind the scenes.
  document.querySelectorAll('.gallery').forEach((gallery) => {
    const mainButton = gallery.querySelector('.gallery-main');
    const mainImage = mainButton.querySelector('img');
    const thumbs = [...gallery.querySelectorAll('.gallery-thumb')];
    const images = thumbs.map((thumb) => ({ src: thumb.dataset.src, alt: thumb.dataset.alt }));

    function showImage(index) {
      const image = images[index];
      mainImage.setAttribute('src', image.src);
      mainImage.setAttribute('alt', image.alt);
      thumbs.forEach((thumb, i) => thumb.classList.toggle('active', i === index));
    }

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => showImage(index));
    });

    mainButton.addEventListener('click', () => {
      const currentIndex = thumbs.findIndex((thumb) => thumb.classList.contains('active'));
      openLightbox(images, currentIndex, showImage);
    });
  });

  // One full-screen viewer, shared by every gallery on the page — created
  // the first time it's needed, then reused. Tracks which image list and
  // index is currently showing so the arrows/keys know what "next" means.
  let lightboxImages = [];
  let lightboxIndex = 0;
  let lightboxOnChange = null;

  function openLightbox(images, index, onChange) {
    lightboxImages = images;
    lightboxIndex = index;
    lightboxOnChange = onChange;

    let lightbox = document.querySelector('.lightbox');
    if (!lightbox) {
      lightbox = document.createElement('div');
      lightbox.className = 'lightbox';
      lightbox.innerHTML = `
        <button type="button" class="lightbox-close" aria-label="Close full-screen image">&times;</button>
        <button type="button" class="lightbox-arrow lightbox-prev" aria-label="Previous image">&larr;</button>
        <img />
        <button type="button" class="lightbox-arrow lightbox-next" aria-label="Next image">&rarr;</button>
      `;
      document.body.appendChild(lightbox);

      // Only closes when the backdrop itself is clicked, not the image or
      // the buttons sitting on top of it.
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      lightbox.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
      lightbox.querySelector('.lightbox-prev').addEventListener('click', () => stepLightbox(-1));
      lightbox.querySelector('.lightbox-next').addEventListener('click', () => stepLightbox(1));

      document.addEventListener('keydown', (event) => {
        if (!lightbox.classList.contains('open')) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') stepLightbox(-1);
        if (event.key === 'ArrowRight') stepLightbox(1);
      });
    }

    lightbox.classList.toggle('single-image', lightboxImages.length <= 1);
    renderLightboxImage();
    lightbox.classList.add('open');
  }

  function stepLightbox(direction) {
    const count = lightboxImages.length;
    lightboxIndex = (lightboxIndex + direction + count) % count;
    renderLightboxImage();
    if (lightboxOnChange) lightboxOnChange(lightboxIndex);
  }

  function renderLightboxImage() {
    const lightbox = document.querySelector('.lightbox');
    const image = lightboxImages[lightboxIndex];
    const lightboxImage = lightbox.querySelector('img');
    lightboxImage.src = image.src;
    lightboxImage.alt = image.alt;
  }

  function closeLightbox() {
    const lightbox = document.querySelector('.lightbox');
    if (lightbox) lightbox.classList.remove('open');
  }
</script>
